#!/usr/bin/env python3
# BEGIN PLZDO-LOCAL:project-frame.verify.v1
from __future__ import annotations

import os
import stat
import sys
import tempfile
from pathlib import Path


MAX_FILE_BYTES = 1_048_576
CONTROL_FILES = (
    (
        "AGENTS.md",
        "<!-- BEGIN PLZDO-LOCAL:project-frame.agents.v1 -->",
        "<!-- END PLZDO-LOCAL:project-frame.agents.v1 -->",
    ),
    (
        "CHECKS.md",
        "<!-- BEGIN PLZDO-LOCAL:project-frame.checks.v1 -->",
        "<!-- END PLZDO-LOCAL:project-frame.checks.v1 -->",
    ),
    (
        "TASKS/current.md",
        "<!-- BEGIN PLZDO-LOCAL:project-frame.tasks-current.v1 -->",
        "<!-- END PLZDO-LOCAL:project-frame.tasks-current.v1 -->",
    ),
    (
        "docs/requirements.md",
        "<!-- BEGIN PLZDO-LOCAL:project-frame.requirements.v1 -->",
        "<!-- END PLZDO-LOCAL:project-frame.requirements.v1 -->",
    ),
    (
        "docs/technical-design.md",
        "<!-- BEGIN PLZDO-LOCAL:project-frame.technical-design.v1 -->",
        "<!-- END PLZDO-LOCAL:project-frame.technical-design.v1 -->",
    ),
    (
        "scripts/verify",
        "# BEGIN PLZDO-LOCAL:project-frame.verify.v1",
        "# END PLZDO-LOCAL:project-frame.verify.v1",
    ),
)


class VerificationError(RuntimeError):
    pass


def _directory_flags() -> int:
    flags = os.O_RDONLY
    flags |= getattr(os, "O_DIRECTORY", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_CLOEXEC", 0)
    return flags


def _file_flags() -> int:
    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_CLOEXEC", 0)
    return flags


def _open_root(path: Path) -> int:
    try:
        descriptor = os.open(path, _directory_flags())
    except OSError as exc:
        raise VerificationError("project root must be a real directory") from exc
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode):
        os.close(descriptor)
        raise VerificationError("project root must be a real directory")
    return descriptor


def _open_directory_at(parent_fd: int, name: str, *, label: str) -> int:
    try:
        descriptor = os.open(name, _directory_flags(), dir_fd=parent_fd)
    except OSError as exc:
        raise VerificationError(f"{label} must be a real directory inside the project") from exc
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode):
        os.close(descriptor)
        raise VerificationError(f"{label} must be a real directory inside the project")
    return descriptor


def _read_regular_at(parent_fd: int, name: str, *, label: str) -> bytes:
    try:
        descriptor = os.open(name, _file_flags(), dir_fd=parent_fd)
    except OSError as exc:
        raise VerificationError(f"{label} must be a regular, non-symlink file") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise VerificationError(f"{label} must be a regular, non-symlink file")
        if metadata.st_size > MAX_FILE_BYTES:
            raise VerificationError(f"{label} exceeds the byte limit")
        chunks: list[bytes] = []
        size = 0
        while True:
            chunk = os.read(descriptor, min(65_536, MAX_FILE_BYTES + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > MAX_FILE_BYTES:
                raise VerificationError(f"{label} exceeds the byte limit")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _read_control(root_fd: int, relative: str) -> bytes:
    parts = relative.split("/")
    if not parts or any(part in {"", ".", ".."} for part in parts):
        raise VerificationError(f"invalid control path: {relative}")
    parent_fd = os.dup(root_fd)
    try:
        for index, part in enumerate(parts[:-1], 1):
            label = "/".join(parts[:index])
            next_fd = _open_directory_at(parent_fd, part, label=label)
            os.close(parent_fd)
            parent_fd = next_fd
        return _read_regular_at(parent_fd, parts[-1], label=relative)
    finally:
        os.close(parent_fd)


def _check_project(root_fd: int) -> list[str]:
    failures: list[str] = []
    for relative, begin, end in CONTROL_FILES:
        try:
            content = _read_control(root_fd, relative)
            text = content.decode("utf-8")
        except (UnicodeDecodeError, VerificationError) as exc:
            failures.append(f"FAIL {relative}: {exc}")
            continue
        lines = text.splitlines()
        if lines.count(begin) != 1 or lines.count(end) != 1:
            failures.append(f"FAIL {relative} has invalid managed markers")
    return failures


def _self_test() -> int:
    marker_begin = "<!-- BEGIN PLZDO-LOCAL:project-frame.requirements.v1 -->"
    marker_end = "<!-- END PLZDO-LOCAL:project-frame.requirements.v1 -->"
    with tempfile.TemporaryDirectory(prefix="plzdo-verifier-self-test-") as temporary:
        base = Path(temporary)
        project = base / "project"
        outside = base / "outside"
        (project / "docs").mkdir(parents=True)
        outside.mkdir()
        invalid = b"invalid project bytes\n"
        valid = f"{marker_begin}\nvalid outside bytes\n{marker_end}\n".encode("utf-8")
        (project / "docs/requirements.md").write_bytes(invalid)
        (outside / "requirements.md").write_bytes(valid)

        root_fd = _open_root(project)
        docs_fd = _open_directory_at(root_fd, "docs", label="docs")
        try:
            (project / "docs").rename(project / "docs-held")
            (project / "docs").symlink_to(outside, target_is_directory=True)
            anchored = _read_regular_at(docs_fd, "requirements.md", label="docs/requirements.md")
            if anchored != invalid:
                raise VerificationError("opened parent descriptor redirected after replacement")
            try:
                _read_control(root_fd, "docs/requirements.md")
            except VerificationError:
                pass
            else:
                raise VerificationError("replacement parent symlink was followed")
        finally:
            os.close(docs_fd)
            os.close(root_fd)
    print("project frame verifier self-test passed")
    return 0


def main(argv: list[str]) -> int:
    if argv == ["--self-test"]:
        return _self_test()
    if argv:
        print("usage: scripts/verify [--self-test]", file=sys.stderr)
        return 2
    script_path = Path(__file__).absolute()
    root_path = script_path.parent.parent
    try:
        root_fd = _open_root(root_path)
    except VerificationError as exc:
        print(f"FAIL {exc}", file=sys.stderr)
        return 1
    try:
        failures = _check_project(root_fd)
    finally:
        os.close(root_fd)
    if failures:
        for failure in failures:
            print(failure, file=sys.stderr)
        return 1
    print(f"project frame check passed: {len(CONTROL_FILES)} files")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
# END PLZDO-LOCAL:project-frame.verify.v1
