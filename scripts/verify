#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "${0%/*}" && pwd -P)
root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
export PATH="/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin"

acceptance_expected=""
core_python39=0
release_matrix=0
if [ "$#" -eq 2 ] && [ "$1" = "--acceptance" ]; then
  if [ -z "$2" ]; then
    echo "FAIL acceptance requires a nonempty full commit SHA" >&2
    exit 2
  fi
  acceptance_expected=$2
  release_matrix=1
elif [ "$#" -eq 1 ] && [ "$1" = "--release-matrix" ]; then
  release_matrix=1
elif [ "$#" -eq 1 ] && [ "$1" = "--core-python39" ]; then
  core_python39=1
elif [ "$#" -ne 0 ]; then
  echo "usage: verify [--acceptance <full-commit-sha> | --release-matrix | --core-python39]" >&2
  exit 2
fi

python_bin=""
if [ "$core_python39" -eq 1 ]; then
  for candidate in /usr/local/bin/python3.9 /opt/homebrew/bin/python3.9 /usr/bin/python3.9 /usr/local/bin/python3 /opt/homebrew/bin/python3 /usr/bin/python3; do
    if [ -x "$candidate" ] && "$candidate" -I -S -B -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 9))' 2>/dev/null; then
      python_bin="$candidate"
      break
    fi
  done
else
  for candidate in /usr/local/bin/python3 /opt/homebrew/bin/python3 /usr/bin/python3; do
    if [ -x "$candidate" ] && "$candidate" -I -S -B -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' 2>/dev/null; then
      python_bin="$candidate"
      break
    fi
  done
fi
if [ -z "$python_bin" ]; then
  echo "FAIL required verification interpreter was not found: core lane needs Python 3.9; full harness needs Python 3.11+" >&2
  exit 1
fi
"$python_bin" -B -I -S -c 'import sys; print("verification interpreter:", sys.executable, sys.version.split()[0])'

acceptance_head=""
if [ -n "$acceptance_expected" ]; then
  acceptance_head=$("$python_bin" -B -I "$root/scripts/check_acceptance.py" "$root" "$acceptance_expected")
fi

if [ -e "$root/.git" ] && [ "${PLZDO_VERIFY_EXPORTED:-0}" != "1" ]; then
  if [ ! -d "$root/.git" ] || [ -L "$root/.git" ]; then
    echo "FAIL root Git metadata must be a real directory" >&2
    exit 1
  fi
  export_tmp="$(mktemp -d)"
  trap 'rm -rf "$export_tmp"' EXIT
  "$python_bin" -B -I "$root/scripts/export_worktree.py" "$root" "$export_tmp/tree"
  if [ -n "$acceptance_expected" ]; then
    acceptance_after_export=$("$python_bin" -B -I "$root/scripts/check_acceptance.py" "$root" "$acceptance_expected")
    if [ "$acceptance_after_export" != "$acceptance_head" ]; then
      echo "FAIL acceptance commit changed during export" >&2
      exit 1
    fi
  fi
  if [ "$core_python39" -eq 1 ]; then
    PLZDO_VERIFY_EXPORTED=1 /bin/sh "$export_tmp/tree/scripts/verify" --core-python39
  elif [ "$release_matrix" -eq 1 ]; then
    PLZDO_VERIFY_EXPORTED=1 /bin/sh "$export_tmp/tree/scripts/verify" --release-matrix
  else
    PLZDO_VERIFY_EXPORTED=1 /bin/sh "$export_tmp/tree/scripts/verify"
  fi
  if [ -n "$acceptance_expected" ]; then
    acceptance_after_verify=$("$python_bin" -B -I "$root/scripts/check_acceptance.py" "$root" "$acceptance_expected")
    if [ "$acceptance_after_verify" != "$acceptance_head" ]; then
      echo "FAIL acceptance commit changed during verification" >&2
      exit 1
    fi
    printf 'plzdo local acceptance verification passed: %s\n' "$acceptance_head"
  fi
  exit 0
fi

if [ -n "$acceptance_expected" ]; then
  echo "FAIL acceptance requires a checked-out Git repository" >&2
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

export HOME="$tmp/home"
export PLZDO_HOME="$tmp/state"
unset PYTHONOPTIMIZE PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE PYTHONWARNINGS
mkdir -p "$HOME"

if find "$root" -type d -name __pycache__ -print | grep -q .; then
  echo "FAIL pre-existing Python cache found" >&2
  exit 1
fi

"$root/scripts/release-manifest" --check
"$python_bin" -B -I "$root/tests/contract_check.py"
"$python_bin" -B -I "$root/tests/smoke_check.py"
"$python_bin" -B -I "$root/tests/phase2_check.py"
"$python_bin" -B -I "$root/tests/phase3_check.py"
"$python_bin" -B -I "$root/tests/phase4_check.py"
"$python_bin" -B -I "$root/tests/phase5_check.py"
"$python_bin" -B -I "$root/tests/local_ops_check.py"
"$python_bin" -B -I "$root/tests/release_check.py"
if [ "$core_python39" -eq 1 ]; then
  "$python_bin" -B -I -S "$root/tests/core_packaging_check.py" --core-only
else
  "$python_bin" -B -I -S "$root/tests/core_packaging_check.py"
  "$python_bin" -B -I -S "$root/tests/adapter_check.py"
fi
"$root/scripts/check-release-leaks" --root "$root" --quiet-warnings

if find "$root" -type d -name __pycache__ -print | grep -q .; then
  echo "FAIL generated Python cache found" >&2
  exit 1
fi

if [ "$core_python39" -eq 1 ]; then
  echo "plzdo core Python 3.9 verification passed"
else
  if [ "$release_matrix" -eq 1 ]; then
    PLZDO_VERIFY_EXPORTED=1 /bin/sh "$root/scripts/verify" --core-python39
    echo "plzdo release compatibility matrix verification passed"
  else
    echo "plzdo local integrated verification passed"
  fi
fi
