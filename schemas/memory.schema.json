{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural interchange contract; runtime validation is authoritative for cross-field, chronology, digest, identity, and sensitive-content semantics.",
  "$id": "https://example.invalid/plzdo-local/memory.schema.json",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "maxLength": 27,
            "minLength": 20,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z$",
            "type": "string"
          },
          "domain": {"pattern": "^[a-z][a-z0-9-]{1,63}$", "type": "string"},
          "id": {"pattern": "^note-[0-9a-f]{24}$", "type": "string"},
          "label": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "sourceOfTruth": {"const": false},
          "stableKey": {"pattern": "^mem-[0-9a-f]{20}$", "type": "string"},
          "state": {"enum": ["active", "superseded"]},
          "summary": {
            "maxLength": 1200,
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "supersedes": {
            "anyOf": [
              {"pattern": "^[a-z][a-z0-9-]{1,63}$", "type": "string"},
              {"type": "null"}
            ]
          }
        },
        "required": ["id", "stableKey", "label", "domain", "summary", "state", "supersedes", "createdAt", "sourceOfTruth"],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "schemaVersion": {"const": "plzdo-local.memory.v1"},
    "sourceOfTruth": {"const": false}
  },
  "required": ["schemaVersion", "sourceOfTruth", "items"],
  "title": "PlzDo Local Memory Store",
  "type": "object"
}
