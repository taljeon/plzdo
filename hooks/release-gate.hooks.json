{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{PLZDO}}/hooks/release-gate.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit({{CONFIG}}/plzdo/state/**)"
    ]
  }
}
